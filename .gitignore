# Legacy flat layout (migrated boards live under boards/)
workspace/style/*
# Track extracted palette + style sheet so another clone can open the editor
# without re-running "Extract style from mockup".
!workspace/style/palette.json
!workspace/style/palette.gpl
!workspace/style/palette_swatch.png
!workspace/style/style_sheet.png
workspace/candidates/*
workspace/cleaned/*
workspace/approved/*
workspace/refinements/*
workspace/preview/*
workspace/logs/*
!workspace/**/.gitkeep
board_assets/*
!board_assets/.gitkeep

# Per-board workspace artifacts
boards/*/workspace/style/*
!boards/*/workspace/style/palette.json
!boards/*/workspace/style/palette.gpl
!boards/*/workspace/style/palette_swatch.png
!boards/*/workspace/style/style_sheet.png
# live/ = promoted PNG per cell — NOT ignored so clones show the same board grid.
# history/, candidates/, etc. stay ignored (high churn / huge trees).
boards/*/workspace/candidates/*
boards/*/workspace/cleaned/*
boards/*/workspace/approved/*
boards/*/workspace/refinements/*
boards/*/workspace/preview/*
boards/*/workspace/logs/*
boards/*/workspace/history/*
boards/*/workspace/frames/*
boards/*/workspace/.costs.jsonl
boards/*/board_assets/*
!boards/*/board_assets/.gitkeep
!boards/*/workspace/**/.gitkeep

__pycache__/
*.pyc
.DS_Store

# SQLite: commit ``boards/.boardfactory.db`` for identical clones; ignore sidecar
# files so WAL/SHM from a running container do not dirty the working tree.
boards/.boardfactory.db-journal
boards/.boardfactory.db-wal
boards/.boardfactory.db-shm
# Local only: map DB board_id -> on-disk folder when names differ (see
# boardfactory.config.board_disk_map). Copy from .board_disk_map.json.example.
data/boards/.board_disk_map.json

.pytest_cache/
